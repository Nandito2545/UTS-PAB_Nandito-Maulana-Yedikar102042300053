<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_053"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_053"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventarisBarang053"
        tools:targetApi="34">

        <activity
            android:name=".ui.LoginActivity_053"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegisterActivity_053"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DashboardActivity_053"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.FormItemActivity_053"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
